* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f4f6f8;
    color: #222;
}

header {
    background: #1f2937;
    color: white;
    padding: 20px;
}

header h1 {
    margin: 0 0 15px;
}

nav {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

nav a {
    color: white;
    text-decoration: none;
    background: #374151;
    padding: 10px 15px;
    border-radius: 5px;
}

nav a:hover {
    background: #4b5563;
}

main {
    max-width: 1100px;
    margin: auto;
    padding: 30px 20px;
}

.cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.card {
    background: white;
    padding: 25px;
    border-radius: 10px;
    box-shadow: 0 2px 8px rgba(0,0,0,.1);
}

.card p {
    font-size: 32px;
    font-weight: bold;
}

.card a {
    text-decoration: none;
}

.form-box {
    background: white;
    padding: 25px;
    margin-bottom: 30px;
    border-radius: 10px;
}

label {
    display: block;
    margin-top: 15px;
    margin-bottom: 5px;
    font-weight: bold;
}

input,
select {
    width: 100%;
    padding: 12px;
    border: 1px solid #ccc;
    border-radius: 5px;
}

button {
    margin-top: 20px;
    padding: 12px 20px;
    border: none;
    border-radius: 5px;
    background: #2563eb;
    color: white;
    cursor: pointer;
}

button:hover {
    background: #1d4ed8;
}

table {
    width: 100%;
    border-collapse: collapse;
    background: white;
}

th,
td {
    padding: 12px;
    border: 1px solid #ddd;
    text-align: left;
}

th {
    background: #e5e7eb;
}

.delete {
    color: #dc2626;
    text-decoration: none;
}

.success {
    background: #dcfce7;
    color: #166534;
    padding: 15px;
    margin-bottom: 20px;
    border-radius: 5px;
}

.error {
    background: #fee2e2;
    color: #991b1b;
    padding: 15px;
    margin-bottom: 20px;
    border-radius: 5px;
}


/* MOBILE */

@media (max-width: 700px) {

    .cards {
        grid-template-columns: 1fr;
    }

    nav {
        flex-direction: column;
    }

    nav a {
        display: block;
    }

    table {
        display: block;
        overflow-x: auto;
    }

    main {
        padding: 20px 10px;
    }

}